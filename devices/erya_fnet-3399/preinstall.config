# QuartzWrt 设备专用预装层（WP-12 预装分层 · L2；仅 Erya FNet3399）
#
# 覆盖语义：本文件在装配序列中最后，可覆盖通用层同符号行——例如
# config/common.config 的 `luci-app-qmodem-next=m`（构建进 feed、不预装）
# 被本文件覆盖为 `=y`（预装）；compose-seed.sh 会打印覆盖明细。
#
# 判据与通用层一致：**依赖闭包不抄**（闭包项由 Kconfig select 图重建），
# 行内注释标出各显式项带出的闭包；断言由 check-manifest.sh 的 Gate B 派生 +
# device.env 的设备验收清单（可含闭包项——断言比选择宽是刻意的：上游闭包变化时构建即红）。

# ── 5G 模组（qmodem 链；本机型的核心用途）────────────────────────────────────
# luci-app-qmodem-next 经 LUCI_DEPENDS 带出 qmodem + qmodem-smsd + sms-forwarder-next；
# qmodem 自身 DEPENDS 再带出 kmod-usb-*（usb2/usb3/serial/option/qualcomm/wdm/cdc-*）
# 与 QMI 驱动闭包——驱动变体由 config/common.config 的
# qmodem_INCLUDE_generic-qmi-wwan=y 选 generic（上游 CI 同款；vendor 驱动留设备专项实测）。
CONFIG_PACKAGE_luci-app-qmodem-next=y

# ── 板载 AP6236（BCM43430B0）无线/蓝牙（WP-11，2026-10-15）────────────────────
CONFIG_PACKAGE_brcmfmac-firmware-fnet3399=y  # 固件随设备层投放（files/package/firmware/）
CONFIG_PACKAGE_kmod-brcmfmac=y              # 带出 kmod-brcmutil / kmod-cfg80211（→ wifi-scripts、wireless-regdb）
CONFIG_PACKAGE_wpad-openssl=y               # 无线用户态（AP 最小集；与基座 rockchip 既有无线机型配方同款）
CONFIG_PACKAGE_kmod-hci-uart=y              # 带出 kmod-btbcm → kmod-bluetooth（UART0 蓝牙内核侧栈）
