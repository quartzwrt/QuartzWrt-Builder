fancontrol.settings.exit_speed='255'
fancontrol.settings.temp_div='1000'
fancontrol.settings.interval='5'
fancontrol.settings.debug='0'

== /var/run/fancontrol.status
running=1
fan_active=1
temperature_mc=43333
pwm=60
rpm=-1
thermal_file=/sys/class/thermal/thermal_zone0/temp
fan_file=/sys/class/hwmon/hwmon2/pwm1
