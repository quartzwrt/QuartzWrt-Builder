// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
//
// Erya FNet3399 —— SW799 核心板板载 AP6236（Ampak；芯片识别为 BCM43430B0）无线/蓝牙使能
//
// QuartzWrt 设备适配层追加（2026-10-15），由 rk3399-fnet-3399.dts 末尾 #include 引入；
// 厂商原版 DTS 不含无线节点（vendor 未启用），本文件内容全部来自公开的 SW799 布线资料，
// 四份独立来源逐字段一致：
//   - cm9vdA/build-linux    boot/dts/rockchip/{mainline,bsp}/rk3399-fine3399.dts
//   - unifreq/linux-6.6.y   arch/arm64/boot/dts/rockchip/rk3399-bozz-sw799.dts
//   - armbian/build         patch/kernel/archive/rockchip64-6.18/dt/rk3399-fine3399.dts
//   - Lemon1151/iStoreOS-RK3399  fnet3399/kernel-rockchip/patches/993-...（model/compatible
//     与厂商 DTS 逐字段一致：erya,fnet-3399 —— 即本板专用移植）
//
// 关键引脚（均在 SW799 核心板内部，与 FNet3399 底板已用引脚无交叠）：
//   WL_REG_ON     gpio0 RK_PB2  sdio_pwrseq reset-gpios（低有效，兼作 SDIO 上电时序）
//   WL_HOST_WAKE  gpio0 RK_PA3  wifi@1 host-wake 中断（高有效）
//   BT_REG_ON     gpio0 RK_PB1  bluetooth shutdown-gpios（高有效）
//   BT_HOST_WAKE  gpio0 RK_PA4  bluetooth host-wakeup-gpios（高有效）
//   BT_WAKE       gpio2 RK_PD2  bluetooth device-wakeup-gpios（高有效）
//   32.768kHz LPO 与 SDIO 参考时钟均取自 RK808 CLKOUT（clocks = <&rk808 1>）
//
// 固件名（内核源码核实）：
//   brcmfmac：sdio.c BRCMF_FW_ENTRY(43430, 0xFFFFFFFC, 43430B0) → brcmfmac43430b0-sdio.{bin,txt}；
//     of.c 以根节点 compatible 首串为 board_type，故优先尝试 <名>.erya,fnet-3399.{bin,txt}，
//     缺失自动回落通用名（firmware.c alt path → fallback）。
//   btbcm（蓝牙）：subver 0x410c → "BCM43430B0"，HCD 取 brcm/BCM43430B0.hcd。
//   两类固件均由设备包 brcmfmac-firmware-fnet3399 投放（见 devices/erya_fnet-3399/files/package/）。

/ {
	aliases {
		/* 保持厂商原有 mmc0 = &sdhci（eMMC 序号不动），SDIO 无线取 mmc1 */
		mmc1 = &sdio0;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk808 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_reg_on_h>;
		reset-gpios = <&gpio0 RK_PB2 GPIO_ACTIVE_LOW>;
	};
};

&pinctrl {
	sdio-pwrseq {
		wifi_reg_on_h: wifi-reg-on-h {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	wifi {
		wifi_host_wake_l: wifi-host-wake-l {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	bt {
		bt_enable_h: bt-enable-h {
			rockchip,pins = <0 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_host_wake_l: bt-host-wake-l {
			rockchip,pins = <0 RK_PA4 RK_FUNC_GPIO &pcfg_pull_down>;
		};

		bt_wake_l: bt-wake-l {
			rockchip,pins = <2 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&sdio0 {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	clock-frequency = <50000000>;
	disable-wp;
	keep-power-in-suspend;
	max-frequency = <50000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio0_bus4 &sdio0_cmd &sdio0_clk>;
	sd-uhs-sdr104;
	status = "okay";

	brcmf: wifi@1 {
		reg = <1>;
		compatible = "brcm,bcm4329-fmac";
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 GPIO_ACTIVE_HIGH>;
		interrupt-names = "host-wake";
		brcm,drive-strength = <5>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake_l>;
	};
};

/* 蓝牙挂在 UART0（SW799 核心板内部走线；本板控制台为 uart2，不冲突） */
&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_xfer &uart0_cts &uart0_rts>;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm43438-bt";
		clocks = <&rk808 1>;
		clock-names = "lpo";
		device-wakeup-gpios = <&gpio2 RK_PD2 GPIO_ACTIVE_HIGH>;
		host-wakeup-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_HIGH>;
		shutdown-gpios = <&gpio0 RK_PB1 GPIO_ACTIVE_HIGH>;
		max-speed = <4000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_host_wake_l &bt_wake_l &bt_enable_h>;
		vbat-supply = <&vcc3v3_sys>;
		vddio-supply = <&vcc_1v8>;
	};
};
