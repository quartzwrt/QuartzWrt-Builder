# QuartzWrt 构建种子（Erya FNet3399 / rockchip armv8 —— **目标/设备层**；WP-12 分层后 2026-10-15）
#
# 本文件只含**目标与设备专属符号**：
#   - CONFIG_TARGET_* 与分区尺寸（vendor 成品镜像反推，见下）；
#   - **内核能力符号**（CONFIG_BRCMFMAC_SDIO / CONFIG_DRIVER_11AC_SUPPORT）——它们不是包，
#     只有种子/片段能表达（这正是 WP-12 采用"片段分层"而非"meta 包分层"的理由之一）。
#
# 预装包不在本文件：通用层见 config/{common.config, preinstall/*.config}，设备专用见
# devices/erya_fnet-3399/preinstall.config；装配 scripts/compose-seed.sh（后者覆盖前者）。
#
# 分区定案 32/1000（WP-11）：vendor 成品镜像（ImmortalWrt SNAPSHOT r34836）fdisk 反推
#  boot 32MiB + rootfs 1000MiB，基座 ptgen 复现逐字节一致（rockchip 基座默认
#  KERNEL 16MiB / ROOTFS 160MiB 不适用本设备布局）。

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_erya_fnet-3399=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1000

# ── 内核能力符号：SW799 核心板板载 AP6236（BCM43430B0）WiFi/蓝牙（WP-11，2026-10-15）──
# 说明：
#   - CONFIG_BRCMFMAC_SDIO 虽对 TARGET_rockchip 默认 y，此处显式固定；该符号同时带出
#     kmod-mmc 依赖（本目标 CONFIG_MMC=y 为内建，包解析按内建处理）；
#   - CONFIG_DRIVER_11AC_SUPPORT 是 kmod-brcmfmac 可选性的前提（hostapd/Config.in 默认 n，
#     不置 y 该包在菜单里不可选，构建表现为依赖未满足被静默取消）；
#   - 设备树增补（DTS 里的 SDIO0/UART0 与引脚）随设备层 files/ 投放，不在此文件。
CONFIG_BRCMFMAC_SDIO=y
CONFIG_DRIVER_11AC_SUPPORT=y
