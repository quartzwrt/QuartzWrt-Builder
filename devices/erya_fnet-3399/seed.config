CONFIG_TARGET_ROOTFS_PARTSIZE=1000

# WP-9 / D10 阶段 1 翻转（2026-10-15 执行）：自有 apk feed 接入（自建 NAS 静态托管）。
# quartz-defaults 据此生成 /etc/apk/repositories.d/quartz-feed.list（quartz/thirdparty/
# 目标包三行）与 /etc/quartz-ota.url（OTA 源同根，零配置）；索引签名由预置公钥
# quartz.pem 校验。上面三条 CONFIG_FEED_*=m 保持注释（不复活官方死链，坑位 #41）。
# 发布/复核流程见 Builder docs/SIGNING-OTA.md §3.2/§5；发布后自检：
#   scripts/check-feed-live.sh https://sources.quartzwrt.org/quartz-feed
CONFIG_QUARTZ_FEED_BASE_URL="https://sources.quartzwrt.org/quartz-feed"
