# Erya FNet3399（RK3399 软路由/5G 扩展板）设备适配元数据
#
# 素材来源：`E:\Downloads\123pan\Fnet资料`（vendor 适配包，2026-10-14 拷贝至本地
# `~/fnet/Fnet资料`）——含内核/U-Boot DTS、U-Boot defconfig、适配过程说明与三方成品镜像。
# 落地方式：patches/ 对锁定基座打补丁（uboot-rockchip 目标 + rockchip/armv8 设备定义），
# files/ 为原样投放文件（target 内核 DTS + U-Boot src overlay）。详见 docs/TDD.md §4.6。

DEVICE_NAME=erya_fnet-3399
DEVICE_VENDOR=Erya
DEVICE_MODEL="FNet 3399"
DEVICE_TARGET=rockchip
DEVICE_SUBTARGET=armv8
DEVICE_ARCH=arm64
# 目标切换护栏用的唯一标识（写入 $WORK_DIR/.quartz-target）
DEVICE_TARGET_ID=rockchip-armv8-erya_fnet-3399
# U-Boot 变体名（= package/boot/uboot-rockchip 的 U-Boot/fnet3399-rk3399；须与设备定义 UBOOT_DEVICE_NAME 一致）
DEVICE_UBOOT_VARIANT=fnet3399-rk3399
# 设备专属 manifest 断言（公共断言见 scripts/check-manifest.sh）
# 注：设备定义 DEVICE_PACKAGES 还含 kmod-rfkill（vendor 配方原样），但 rockchip 内核
# CONFIG_RFKILL/RFKILL_GPIO 均为内建（=y）→ kmod-rfkill 无包符号、被静默丢弃
# （vendor 成品镜像同样无此包；rfkill-gpio 功能由内建驱动提供）——故不列入断言。
# 无线/蓝牙（WP-11 追加，2026-10-15）：DTS 增补 + 设备侧固件包；wpad-openssl/wifi-scripts/
# wireless-regdb 为可用 AP 的最小用户态集（与基座 rockchip 既有无线设备配方同款）。
# 5G 模组（2026-10-16 追加）：qmodem 选 Vendor QMI + PCIe/MTK-T7XX/Qfirehose 后，由
# config/common.config 的 qmodem_INCLUDE_* 带出的闭包——断言锁定，防上游闭包漂移静默少包；
# generic kmod-usb-net-qmi-wwan 已按选择退役，刻意不列入。
DEVICE_MANIFEST_PACKAGES="kmod-usb-net-rtl8152 kmod-hwmon-pwmfan kmod-brcmfmac kmod-brcmutil brcmfmac-firmware-fnet3399 wpad-openssl wifi-scripts wireless-regdb kmod-bluetooth kmod-btbcm kmod-hci-uart qmodem luci-app-qmodem-next kmod-qmi_wwan_q kmod-qmi_wwan_f kmod-qmi_wwan_s kmod-pcie_mhi kmod-mtk-t7xx umbim qfirehose pciutils"
# 成品镜像匹配式（bin/targets/rockchip/armv8/ 下）
DEVICE_IMAGE_GLOB="*erya_fnet-3399*squashfs-sysupgrade.img.gz"
