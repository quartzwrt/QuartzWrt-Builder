+static bool option_is_tdtech_mh5000_82m(const struct usb_device *udev)
+{
+	u16 product = le16_to_cpu(udev->descriptor.idProduct);
+
+	return le16_to_cpu(udev->descriptor.idVendor) == UNISOC_VENDOR_ID &&
+	       (product == TDTECH_PRODUCT_MH5000_82M_RNDIS ||
+	        product == TDTECH_PRODUCT_MH5000_82M_ECM ||
+	        product == TDTECH_PRODUCT_MH5000_82M_NCM);
+}
