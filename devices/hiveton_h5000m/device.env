# Hiveton H5000M（MT7987A / MediaTek Filogic，WiFi 7 5G CPE）
#
# 基座已原生支持：target/linux/mediatek/filogic 下的 DTS、LED/网络初始化、
# sysupgrade 平台脚本与 Device/hiveton_h5000m 定义均在锁定基座内；本设备层
# 不加厂商补丁，只负责目标种子、Quartz/5G/风扇预装与设备验收断言。
#
# 硬件（公开资料 + 基座 DTS 核对）：
#   - SoC: MediaTek MT7987A（Filogic，4C）
#   - RAM/Flash: 1GB DDR4 / 8GB eMMC（用户侧有改内存版本）
#   - WiFi: MT7992（2.4/5 GHz 双频；驱动包 kmod-mt7996e）+ MT7992-23 固件
#   - 5G: M.2 USB 模组；qmodem 5G 栈按 FNet3399 同款配置默认预装
#   - 风扇: PWM fan（fancontrol 保守曲线，真机需复核）

DEVICE_NAME=hiveton_h5000m
DEVICE_VENDOR=Hiveton
DEVICE_MODEL="H5000M"
DEVICE_TARGET=mediatek
DEVICE_SUBTARGET=filogic
DEVICE_ARCH=arm64
DEVICE_TARGET_ID=mediatek-filogic-hiveton_h5000m

# 设备验收断言（可含闭包项与基座 DEVICE_PACKAGES 项；刻意比"选择"宽）。
# 5G 驱动闭包与 FNet3399 同款：Vendor QMI + MTK T7XX + Qfirehose。
DEVICE_MANIFEST_PACKAGES="kmod-hwmon-pwmfan kmod-usb3 mt7987-2p5g-phy-firmware kmod-mt7996e kmod-mt7992-23-firmware f2fsck mkf2fs automount wpad-openssl wifi-scripts wireless-regdb qmodem kmod-usb-serial-option luci-app-qmodem-next kmod-qmi_wwan_q kmod-mtk-t7xx umbim qfirehose fancontrol luci-app-fancontrol"

# 基座 filogic 产出的 sysupgrade 是 .bin（不是 .img.gz）
DEVICE_IMAGE_GLOB="*hiveton_h5000m*sysupgrade.bin"
