# QuartzWrt 设备专用预装层（Hiveton H5000M）
#
# 完整 quartz-defaults 由通用功能层预装（openclash/bandix/theme/dashboard/
# daemon/app-api 等，QuartzWrt 必吃）；本文件只补设备专属能力：
#   - qmodem 5G 栈：按 FNet3399 同款默认配置预装；驱动选择沿用 common.config 的
#     Vendor QMI + PCIe + MTK-T7XX + Qfirehose，不在此重复。
#   - fancontrol：H5000M 有 PWM 风扇；保守曲线由设备层 uci-defaults 启用。
# 依赖闭包不抄：qmodem/SMS/驱动包由 luci-app-qmodem-next 带出，fancontrol 由
# luci-app-fancontrol 带出。

# 5G 模组（默认配置，与 FNet3399 一致）
CONFIG_PACKAGE_luci-app-qmodem-next=y

# PWM 风扇（守护进程 + LuCI；曲线见 files/target/linux/mediatek/.../99-fancontrol-h5000m）
CONFIG_PACKAGE_luci-app-fancontrol=y
CONFIG_PACKAGE_luci-i18n-fancontrol-zh-cn=y

# ── 板载 WiFi：关闭通用层的加装网卡驱动 ──────────────────────────────────────
# H5000M 自带 MT7992 + MT7992-23（WiFi 7；驱动包 kmod-mt7996e），基座 DEVICE_PACKAGES 已带驱动/固件；
# 通用 drivers.config 的 USB/PCIe 加装网卡驱动对本机是纯体积负担，全部显式关闭。
# 保留：kmod-mt7996e / kmod-mt7992-23-firmware（基座设备定义）+
#       wpad-openssl / wifi-scripts / wireless-regdb（features 层，带 WiFi 用户态）。
# CONFIG_PACKAGE_kmod-mt7921e is not set
# CONFIG_PACKAGE_kmod-mt7921u is not set
# CONFIG_PACKAGE_kmod-mt7925e is not set
# CONFIG_PACKAGE_kmod-mt7925u is not set
# CONFIG_PACKAGE_kmod-mt7663u is not set
# CONFIG_PACKAGE_kmod-mt7601u is not set
# CONFIG_PACKAGE_kmod-mt76x0u is not set
# CONFIG_PACKAGE_kmod-mt76x2u is not set
# CONFIG_PACKAGE_kmod-rtw89-8852be is not set
# CONFIG_PACKAGE_kmod-rtw89-8852ce is not set
# CONFIG_PACKAGE_kmod-rtw89-8922ae is not set
# CONFIG_PACKAGE_kmod-rtw88-8822ce is not set
# CONFIG_PACKAGE_kmod-rtw88-8822bu is not set
# CONFIG_PACKAGE_kmod-rtw88-8821cu is not set
# CONFIG_PACKAGE_kmod-rtl8xxxu is not set
# CONFIG_PACKAGE_kmod-iwlwifi is not set
# CONFIG_PACKAGE_iwlwifi-firmware-ax200 is not set
# CONFIG_PACKAGE_iwlwifi-firmware-ax201 is not set
# CONFIG_PACKAGE_iwlwifi-firmware-ax210 is not set
# CONFIG_PACKAGE_iwlwifi-firmware-be200 is not set
# CONFIG_PACKAGE_kmod-ath11k-pci is not set
# CONFIG_PACKAGE_ath11k-firmware-wcn6855 is not set
# CONFIG_PACKAGE_kmod-ath12k is not set
# CONFIG_PACKAGE_ath12k-firmware-wcn7850 is not set
# CONFIG_PACKAGE_kmod-aic8800-usb is not set
# CONFIG_PACKAGE_kmod-aic8800-pcie is not set
