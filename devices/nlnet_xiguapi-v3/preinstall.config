# QuartzWrt 设备专用预装层（NLnet XiGuaPi V3 / NL68K）
#
# 依赖闭包不抄：qmodem/SMS/驱动包由 luci-app-qmodem-next 带出；mt7915e 的
# kmod-thermal/kmod-hwmon-core 等由 Kconfig select 图重建。这里只锁定
# "设备承诺"与"无人 select"的关键项。
#
# 明确不加：
#   - fancontrol / luci-app-fancontrol —— DTS 的 pwm-fan + thermal cooling-maps
#     已由内核自动调速；用户当前未装风扇，且用户态调速会与内核抢 PWM。
#   - 蓝牙（kmod-btusb / mt7921bt-firmware / mt7922bt-firmware）——用户不需要。
#   - GC9307 屏幕驱动（kmod-fb-tft-st7789v）——v1 不做；DTS 的 gc9307 节点
#     保持未绑定，无副作用。
#   - 通用 WiFi 家族（mt7921e/u、mt7925e/u、rtw89/rtw88、iwlwifi、ath11k/12k、
#     aic8800）——已在 config/preinstall/drivers.config，本文件不重复抄。

# ── 5G 模组（qmodem 链）────────────────────────────────────────────────────
# 与 FNet3399/Photonicat/H5000M 同款：luci-app-qmodem-next 经 LUCI_DEPENDS 带出
# qmodem + qmodem-smsd + sms-forwarder-next；驱动/支持项沿用 common.config 的
# qmodem_INCLUDE_*（Vendor QMI + PCIe/MHI + MTK-T7XX + Qfirehose）。
# M.2 B Key 为 USB 通道；若用 mini-PCIe 转 5G 适配器切 PCIe，同样由该栈覆盖。
CONFIG_PACKAGE_luci-app-qmodem-next=y

# ── MT7915/MT7916（mini-PCIe WiFi）─────────────────────────────────────────
# 通用层没有这两个包；MT7916 固件包 DEPENDS +kmod-mt7915e，显式锁驱动便于 Gate A。
# 前置 CONFIG_KERNEL_RELAY=y 见 seed.config。
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt7916-firmware=y
