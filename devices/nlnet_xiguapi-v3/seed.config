# QuartzWrt 构建种子（NLnet XiGuaPi V3 / rockchip armv8）
#
# 基座原生设备：设备层不加厂商补丁；本文件只固定目标/设备符号、分区尺寸
# 与一个内核能力符号。预装包见 preinstall.config 与公共 config/preinstall/。
#
# 分区（WP-11 口径）：KERNEL 32MiB（与 FNet3399/Photonicat 一致）；
# eMMC 32GB，rootfs 8192MiB 可容纳完整 Quartz 预装、WiFi 固件、Docker 与
# 按需安装的可选包（2G 版本见 2026-11-22 测试镜像；用户 2026-11-23 拍板扩到 8G）。
#
# CONFIG_KERNEL_RELAY=y —— kmod-mt7915e（MT7915/MT7916 mini-PCIe 驱动）在基座
# Kconfig 里 `depends on @KERNEL_RELAY`；rockchip 目标默认 `# CONFIG_RELAY is not set`，
# 不显式打开时该驱动会被 Kconfig 静默丢弃（Gate A 会拦）。这是"内核能力符号"，
# 不是包，只能由种子/片段表达。

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_nlnet_xiguapi-v3=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=8192

# MT7915/MT7916 mini-PCIe 驱动的前置内核符号
CONFIG_KERNEL_RELAY=y
