# NLnet XiGuaPi V3（NL68K / 西瓜皮 V3）设备适配元数据
#
# 基座原生支持：ImmortalWrt 25.12 @ 3682a14d 已包含 rockchip/armv8 的
# Device/nlnet_xiguapi-v3、rk3568-xiguapi-v3.dts、U-Boot xiguapi-v3-rk3568、
# board.d/02_network 与 40-net-smp-affinity。本设备层**不加厂商补丁**，
# 只做目标种子、预装与设备验收断言。
#
# 硬件（公开资料 + 基座 DTS 核对）：
#   - SoC：Rockchip RK3568（4×Cortex-A55，Mali-G52，RK817-5 PMIC）
#   - RAM/Flash：4GB LPDDR4X / 32GB eMMC（SanDisk SDINBDA4-32G）
#   - 有线：2× RTL8211F 千兆；基座初始化 eth0=LAN、eth1=WAN
#   - 扩展：2× mini-PCIe（PCIe WiFi）、M.2 B Key（USB 5G，RM500Q 尺寸）、
#           M.2 E Key（PCIe WiFi + USB2 蓝牙）
#   - 其他：USB-A 3.0 OTG、HDMI 2.0、TF、SIM、GC9307 SPI 屏（320×240）、
#           PWM 风扇（DTS 温控曲线）、3 LED、ADC 复位键
#   - 调试串口：UART2，1500000n8
#
# 本版（v1）不预装 fancontrol（DTS 的 pwm-fan + thermal cooling-maps 已由内核
# 自动调速）；不预装蓝牙。GC9307 屏幕自 2026-11-23（WP-16）起启用：设备层自带
# fbtft 驱动 + quartz-screen 守护 + LuCI 控制（172x320 面板，横屏 320x172）。

DEVICE_NAME=nlnet_xiguapi-v3
DEVICE_VENDOR=NLnet
DEVICE_MODEL="XiGuaPi V3"
DEVICE_TARGET=rockchip
DEVICE_SUBTARGET=armv8
DEVICE_ARCH=arm64
# 目标切换护栏用的唯一标识（写入 $WORK_DIR/.quartz-target）
DEVICE_TARGET_ID=rockchip-armv8-nlnet_xiguapi-v3
# U-Boot 变体名（= package/boot/uboot-rockchip 的 U-Boot/xiguapi-v3-rk3568）
DEVICE_UBOOT_VARIANT=xiguapi-v3-rk3568

# 设备验收断言（可含闭包项与基座 DEVICE_PACKAGES 项；刻意比"选择"宽）。
# 基座 profile：风扇 PWM、ADC 按键、SARADC。
# 加装 WiFi：MT7915/MT7916 为设备层新增；MT7922/MT7921、QCNFA765/QCA2066、
#            RTL8852 等由通用 drivers.config 覆盖，这里只取各家族代表项。
# 5G：qmodem 栈（Vendor QMI + PCIe/MHI + MTK-T7XX + Qfirehose），与 FNet3399/
#     Photonicat/H5000M 同款闭包；USB M.2 B Key 与 mini-PCIe PCIe 适配器都覆盖。
# 用户态：ttyd（通用功能层预装；设备层投放登录加固，root 密码未设置时拒绝登录）。
# 小屏：设备层 fbtft 驱动 + quartz-screen（守护/渲染）+ LuCI 控制（WP-16）。
DEVICE_MANIFEST_PACKAGES="kmod-hwmon-pwmfan kmod-input-adc-keys kmod-saradc-rockchip \
  kmod-mt7915e kmod-mt7915-firmware kmod-mt7916-firmware kmod-mt7921e \
  kmod-ath11k-pci kmod-rtw89-8852be wpad-openssl wifi-scripts wireless-regdb \
  qmodem kmod-usb-serial-option luci-app-qmodem-next \
  kmod-qmi_wwan_q kmod-qmi_wwan_f kmod-qmi_wwan_s kmod-pcie_mhi kmod-mtk-t7xx \
  umbim qfirehose pciutils usbutils ttyd luci-app-ttyd \
  kmod-fb-tft-gc9307 quartz-screen luci-app-quartz-screen luci-i18n-quartz-screen-zh-cn"

# 成品镜像匹配式（bin/targets/rockchip/armv8/ 下）
DEVICE_IMAGE_GLOB="*nlnet_xiguapi-v3*squashfs-sysupgrade.img.gz"
