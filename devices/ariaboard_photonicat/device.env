# Ariaboard Photonicat（光影猫一代，RK3568）设备适配元数据
#
# 基座原生支持：rockchip/armv8 的 Device/ariaboard_photonicat、DTS（QCA9377
# SDIO WiFi、YT8521 双千兆、eMMC/SD、PMU UART4）、U-Boot photonicat-rk3568
# 与 board.d/02_network、etc/init.d/{phy-leds,reload-sdio-wifi} 均在锁定基座内。
#
# 本设备层**不加厂商补丁**，只做四件事：
#   1. 目标/设备种子与分区尺寸（seed.config）；
#   2. 板载 WiFi 完全沿用基座 25.12 官方 profile 默认：kmod-ath10k-sdio +
#      通用 ath10k-firmware-qca9377-sdio（不切 Photonicat 专用固件、不加补丁）；
#   3. 外接 USB/PCIe WiFi 网卡驱动：保留公共层 config/preinstall/drivers.config
#      的完整驱动/固件集（与 FNet3399 同口径，不学 H5000M 显式关闭）；
#   4. 电池：pcat-mgr（基座 DEVICE_PACKAGES 已带）通过 FUSE 暴露
#      /sys/class/power_supply/pcat-{battery,charger}；设备层补齐 kmod-fuse /
#      luci-mod-battstatus / 中文翻译，并用 uci-defaults 写 /etc/pcat-mgr.json
#      （DTS OCV 表）与启用服务。
#
# 不包含：QCA9377 蓝牙（基座未开 CONFIG_BT_HCIUART_QCA，需另做驱动/固件）。
# 5G：按 FNet3399/H5000M 同款口径预装 qmodem 栈（luci-app-qmodem-next）；
# 基座 profile 自带的 MBIM/QMI/option/uqmi 保留。

DEVICE_NAME=ariaboard_photonicat
DEVICE_VENDOR=Ariaboard
DEVICE_MODEL="Photonicat"
DEVICE_TARGET=rockchip
DEVICE_SUBTARGET=armv8
DEVICE_ARCH=arm64
DEVICE_TARGET_ID=rockchip-armv8-ariaboard_photonicat
# U-Boot 变体名（= package/boot/uboot-rockchip 的 U-Boot/photonicat-rk3568；
# 设备定义默认 UBOOT_DEVICE_NAME = photonicat-rk3568）
DEVICE_UBOOT_VARIANT=photonicat-rk3568

# 设备验收断言（可含闭包项与基座 DEVICE_PACKAGES 项；刻意比"选择"宽）。
# 板载 WiFi：官方通用 ath10k 驱动/固件 + 用户态。
# 外接 WiFi：只断言公共驱动层的代表项（完整清单见 config/preinstall/drivers.config，
#           不在此重复抄；FNet3399 同类包已实测可构建）。
# 电池：pcat-mgr + FUSE 闭包 + LuCI 指示器/中文翻译。
# 5G：qmodem 栈（与 H5000M 同款断言集；USB B-Key 不涉及 PCIe/MHI）。
# libfuse 的 apk/manifest 名为 libfuse1（ABI 后缀无连字符），断言用实际包名。
DEVICE_MANIFEST_PACKAGES="kmod-ath10k-sdio ath10k-firmware-qca9377-sdio ath10k-board-qca9377-sdio wpad-openssl wifi-scripts wireless-regdb kmod-mt7921e kmod-mt7921u kmod-mt7925e kmod-rtw89-8852be kmod-iwlwifi kmod-ath11k-pci ath11k-firmware-wcn6855 ath11k-firmware-qca2066 kmod-ath12k kmod-aic8800-usb pcat-mgr kmod-fuse fuse-utils libfuse1 luci-mod-battstatus luci-i18n-battstatus-zh-cn qmodem kmod-usb-serial-option luci-app-qmodem-next kmod-qmi_wwan_q kmod-mtk-t7xx umbim qfirehose kmod-usb-net-cdc-mbim kmod-usb-net-qmi-wwan uqmi"
DEVICE_IMAGE_GLOB="*ariaboard_photonicat*squashfs-sysupgrade.img.gz"
