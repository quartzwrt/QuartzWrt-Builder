# QuartzWrt 设备专用预装层（Ariaboard Photonicat / 光影猫一代）
#
# 依赖闭包不抄：kmod-ath10k-sdio 的 kmod-ath/kmod-mmc、ath10k-firmware-qca9377-sdio
# 的 ath10k-board-qca9377-sdio、pcat-mgr 的 fuse-utils→libfuse→kmod-fuse
# 都由 Kconfig/apk 依赖带出；这里只锁定设备承诺的关键包与无人 select 的项。
# kmod-fuse 虽在闭包里，但它是电池功能的内核前提，显式锁定以便 Gate A 检查。

# ── 板载 WiFi：完全沿用基座 25.12 官方 profile 默认 ─────────────────────────
# 官方 Device/ariaboard_photonicat 已带 kmod-ath10k-sdio + 通用
# ath10k-firmware-qca9377-sdio；不切 Photonicat 专用固件、不加固件补丁。
# 显式锁定只为防止基座 bump 后 profile 静默变化（Gate A 会拦）。
CONFIG_PACKAGE_kmod-ath10k-sdio=y
CONFIG_PACKAGE_ath10k-firmware-qca9377-sdio=y

# ── 外接 USB/PCIe WiFi 网卡：保留公共驱动层 ─────────────────────────────────
# 与 FNet3399 同口径：config/preinstall/drivers.config 统一预装 mt792x / rtw88 /
# rtw89 / iwlwifi / ath11k / ath12k / aic8800 等网卡驱动与固件。本设备**不做**
# H5000M 那样的显式关闭；完整清单见公共层，不在此重复抄包。

# ── 5G 模组（qmodem 链）────────────────────────────────────────────────────
# 与 FNet3399/H5000M 同款默认配置：luci-app-qmodem-next 经 LUCI_DEPENDS 带出
# qmodem + qmodem-smsd + sms-forwarder-next；驱动/支持项沿用 config/common.config
# 的 qmodem_INCLUDE_*（Vendor QMI + PCIe + MTK-T7XX + Qfirehose）。
# Photonicat 的 M.2 B-Key 是 USB 通道，qmodem 由 qmodem_init/modem_scan 自动建
# section；B-Key 的 rfkill-modem 节点由基座 DTS 提供。
CONFIG_PACKAGE_luci-app-qmodem-next=y

# ── 电池：pcat-mgr + FUSE + LuCI 指示器 ──────────────────────────────────────
# pcat-mgr 在基座 Device/ariaboard_photonicat 的 DEVICE_PACKAGES 里；它通过
# go-fuse 把 pcat-battery/pcat-charger 挂到 /sys/class/power_supply/。
# kmod-fuse 是其运行前提（pcat-mgr→fuse-utils→libfuse→kmod-fuse），显式锁定。
# luci-mod-battstatus 的 rpcd 已原生支持 board=ariaboard,photonicat，并给出
# "Need pcat-mgr" 兜底；中文翻译包无人 select，显式列出。
CONFIG_PACKAGE_pcat-mgr=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_luci-mod-battstatus=y
CONFIG_PACKAGE_luci-i18n-battstatus-zh-cn=y
