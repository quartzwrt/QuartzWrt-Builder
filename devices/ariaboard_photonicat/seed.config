# QuartzWrt 构建种子（Ariaboard Photonicat / rockchip armv8）
#
# 基座原生设备：设备层不加厂商补丁；本文件只固定目标/设备符号与分区尺寸。
# 板载 WiFi 走官方 25.12 profile 默认（通用 ath10k 固件），设备专属包见
# preinstall.config；外接 WiFi 驱动由公共 config/preinstall/drivers.config 提供。
# eMMC 16GB 或 64GB，rootfs 2048MiB 可容纳完整 Quartz 预装与 docker 变体；
# KERNEL 32MiB 与 FNet3399 口径一致。

CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_rockchip_armv8_DEVICE_ariaboard_photonicat=y
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
