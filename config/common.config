# QuartzWrt 跨目标通用层（WP-12）——与目标/设备无关的构建面与分发面符号
#
# 装配顺序（scripts/compose-seed.sh）：
#   common.config → <目标种子> → preinstall/drivers.config → preinstall/features.config
#   → devices/<设备>/seed.config → devices/<设备>/preinstall.config
# 后者覆盖前者（同一符号重复时最后出现者胜，compose-seed.sh 会打印覆盖明细）。
#
# 本文件只放"所有目标/设备一致"的构建面与分发面开关；**不放任何预装包**
# （预装包见 config/preinstall/，设备专属见 devices/<设备>/）。

# 注：旧种子里的 `CONFIG_CCACHE=y` 已移除——Gate A 实测（2026-10-15，WP-12）该符号在
# 锁定基座 25.12 中**不存在**（Config.in 与生成的 .config-package.in 均无；两种子基线
# .config 里也没有它），即老种子里这条从未生效、每次 defconfig 都被静默丢弃。
# ccache 由构建目录 `.ccache` 符号链接 + CONFIG_CCACHE_DIR 等控制（见 build-local.sh 第 7 步）。

# ── distfeeds 收敛（坑位 #41）────────────────────────────────────────────────
# 基座 include/feeds.mk 对 feeds.conf 里每个 feed 输出一行
# `%U/packages/%A/<feed>/packages.adb`（%U = CONFIG_VERSION_REPO，未设则官方
# downloads 主机）；值为 m 时输出 `# ` 注释行。未发布的 quartz/thirdparty/video
# 三条若落默认 y，镜像内 distfeeds 会指向官方 404 路径 → apk update 报
# unavailable（exit 3）、apk upgrade 被整体拒绝（exit 99）；add/del 不受影响。
#
# 翻转状态（WP-9/D10）：
#   阶段 1（已执行，2026-10-15）：发布签名 feed 后设 CONFIG_QUARTZ_FEED_BASE_URL
#     （下方）——固件经 quartz-defaults 生成 /etc/apk/repositories.d/quartz-feed.list
#     接入自有源；**上面三条 =m 保持注释**（不复活官方死链）。
#   阶段 2（全量自包含，未执行）：全量镜像发布后设
#     CONFIG_VERSION_REPO="https://<托管根>" 并把 CONFIG_FEED_{quartz,thirdparty}
#     翻回 =y——**两动作必须成对**，单独翻 =y 会重新指向官方 404 路径（2026-10-15
#     设备种子漏掉这三行即此坑的实例：已发布 v0.1.1 镜像 distfeeds 三条 404 未注释）。
CONFIG_FEED_quartz=m
CONFIG_FEED_thirdparty=m
CONFIG_FEED_video=m

# ── 自有 feed 接入（WP-9 / D10 阶段 1）────────────────────────────────────────
# quartz-defaults 据此生成 /etc/apk/repositories.d/quartz-feed.list
# （quartz / thirdparty / 目标包三行）与 /etc/quartz-ota.url；索引签名由预置公钥
# quartz.pem 校验。留空则不落文件（安全默认，防死链）。
CONFIG_QUARTZ_FEED_BASE_URL="https://sources.quartzwrt.org/quartz-feed"

# ── feed 构建面（构建但不预装；供自有 feed 发布与按需安装）──────────────────────
# WP-7/WP-9：qmodem 与 mosdns 收录进 feed，但默认不随固件预装。
# 设备专用预装（如 FNet3399 的 5G 机型）在 devices/<设备>/preinstall.config 里
# 以 `=y` 覆盖本行的 `=m`（compose-seed.sh 覆盖语义）。
# qmodem 驱动/支持项（2026-10-15 用户拍板，设备专项实测）：Vendor QMI 驱动
# （kmod-qmi_wwan_q/_f/_s 随 qmodem 拉起）+ PCIe（pciutils；并使 MHI 驱动选择可见，
# 取 Kconfig 默认 Vendor MHI → kmod-pcie_mhi）+ MTK-T7XX（kmod-mtk-t7xx + umbim）
# + Qfirehose。原先的 generic（上游 CI 同款）已退役。
CONFIG_PACKAGE_luci-app-qmodem-next=m
CONFIG_PACKAGE_luci-app-mosdns=m
CONFIG_PACKAGE_qmodem_INCLUDE_vendor-qmi-wwan=y
CONFIG_PACKAGE_qmodem_INCLUDE_ADD_PCI_SUPPORT=y
CONFIG_PACKAGE_qmodem_INCLUDE_ADD_MTK_T7XX_SUPPORT=y
CONFIG_PACKAGE_qmodem_INCLUDE_ADD_QFIREHOSE_SUPPORT=y

# ── 镜像格式：只出 squashfs（2026-10-16 用户指令）─────────────────────────────
# include/image.mk 的 fs-types 由 TARGET_ROOTFS_{SQUASHFS,EXT4FS} 决定
# （`fs-types-$(CONFIG_TARGET_ROOTFS_SQUASHFS) += squashfs` / 同款 ext4 行）：
# 关掉 EXT4FS 后，x86 不再产出 ext4-* 三种（combined / combined-efi / rootfs），
# 设备不再产出 ext4-sysupgrade——只剩 squashfs 系列，镜像数与构建时间同步收敛。
# 注：本行是 Kconfig 的"显式关掉"写法（语义行），compose-seed.sh 会把它当装配行
# 参与 Gate A（2026-10-16 起支持该写法；此前 `#` 行一律被当注释跳过）。
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
