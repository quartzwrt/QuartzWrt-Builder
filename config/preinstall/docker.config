# QuartzWrt docker 变体层（2026-10-16 用户指令：固件分「带/不带 docker」两版）
#
# 用法：compose-seed.sh --docker 装配本层（build-local.sh --variants 与 CI 的 docker
# 输入会自动传入）；不带 --docker 时本文件完全不参与装配——标准版镜像里依旧没有
# docker 栈，check-manifest.sh 的 docker **反向断言**照旧生效；带 --docker 时该断言
# 翻为**正向**（docker 栈必须在 manifest 在列）。
#
# 清单沿用 2026-10-12「docker 移出预装」之前的已验证集合（git b12e96f 之前），
# 按「依赖闭包不抄」原则只列显式项：containerd / runc / tini / kmod-* 等由
# dockerd 的 DEPENDS 带出，不进本清单。
#
# ⚠ docker × fw4 注意：dockerd 默认 iptables 后端在本基座（xtables-nft 兼容层）下
#   会把规则写成 `-A` 形式 → LuCI 状态页报「检测到旧版规则」。本层配套的文件叠加
#   config/preinstall/docker.files/（daemon.json 选 nftables 后端 + uci-defaults
#   写入 dockerd.globals.{iptables=0,alt_config_file}）由构建脚本在 --docker 变体时
#   投放（机理与验证见 WORKPLAN 坑位 #24）。**关键坑**：daemon.json 的
#   "iptables": true 必须保持——置 false 会把 nft 后端的 IPv4 编程一起静默关掉。
#
# 体积影响：docker 栈 ~244MB（坑位 #14），rootfs 分区维持 1024/1000（标准版同值，
# 不为变体改变分区布局）；docker 数据目录 /opt/docker 落在可写 overlay 上。

# docker 包构建选项（默认即 y，显式固定；STO_EXT4 = 允许 ext4 作为数据盘后端，
# 带出 KERNEL_EXT4_FS_POSIX_ACL/SECURITY——overlay 分区为 ext4，保留）
CONFIG_DOCKER_CGROUP_OPTIONS=y
CONFIG_DOCKER_NET_MACVLAN=y
CONFIG_DOCKER_STO_EXT4=y

# docker 栈本体（闭包由依赖带出）
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-lib-docker=y
