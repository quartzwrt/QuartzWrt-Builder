# QuartzWrt 通用驱动层（WP-12 预装分层 · L1-驱动；所有设备都装）
#
# 收编判据（用户拍板「最小承诺」，2026-10-15）：
#   1. **依赖闭包不抄**——任何功能包的 DEPENDS 已经保证的 kmod 不在此列（openclash →
#      kmod-tun / kmod-nft-tproxy / kmod-inet-diag；btrfs-progs → kmod-fs-btrfs 及其
#      crypto/lib 闭包；iptables-nft / xtables-nft → kmod-ipt-* 与 libiptext*）。
#      Kconfig 的 select 图会随功能包自动重建这些项（这正是"删掉也逐行一致"的机制），
#      重复列出只会让边界看不清；它们的存在性由 check-manifest.sh 的派生断言（Gate B）
#      与功能包本身共同兜底。
#   2. **硬件子集归设备层**——只服务某类硬件的驱动（USB 网卡 rtl8152、风扇 pwmfan、
#      无线 brcmfmac/wpad、蓝牙栈、5G QMI 驱动等）放 devices/<设备>/ 或设备定义的
#      DEVICE_PACKAGES，不入本层。
#   3. **本层只放"没有功能包替你保证、但 QuartzWrt 对全部设备承诺"的内核能力。**
#
# 当前清单（两组）：
#   ① 基础内核能力（5 项，均为"无人 select"的显式选择——删任一都会改变镜像，Gate A 会拦）：
#      kmod-dummy        虚拟网络接口（诊断/测试夹具：netns+veth/dummy 转发计量验收用）
#      kmod-veth         虚拟以太网对（同上）
#      kmod-ipt-nat6     IPv6 NAT（NAT66 能力承诺）
#      kmod-ipt-physdev  按物理入接口匹配（多 WAN / 分流场景）
#      kmod-nf-ipvs      IPVS（负载均衡 / 透明代理能力）
#   ② 常见 WiFi 网卡（见下方专段；2026-10-15 追加）
#
# 新增驱动：先经 scripts/compose-seed.sh 的 Gate A（片段行必须保留在最终 .config，
# 防止被 Kconfig 静默丢弃），再走镜像级验证。

CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ipt-physdev=y
CONFIG_PACKAGE_kmod-nf-ipvs=y

# ── 常见 WiFi 网卡（加装 M.2/USB 网卡；WP-12 追加 2026-10-15，用户拍板）────────────
# 范围：x86 小盒子 / ARM 板卡上最主流的**加装形态**（PCIe + USB）。板载 SDIO 形态
# （mt7921s 等）不入本层——那是焊死形态，属设备层（如 FNet3399 的 brcmfmac SDIO）。
# 固件是体积大头（本段合计约 35MB，Qualcomm 两块占 20.5MB）：多数随驱动包 select
# 带出（mt792x → 固件包；mt76x0u/mt76x2u → 固件由 mt76x0-common/mt76x2-common 投放；
# rtw8x/rtw89/aic8800 各自 select 固件），Intel 与 Qualcomm 需显式点名固件包。
# 依赖闭包不抄：kmod-cfg80211 / kmod-mac80211 / iwinfo / ucode-mod-nl80211 均由驱动
# 与 wpad 带出；**WiFi 用户态**（wpad-openssl / wifi-scripts / wireless-regdb）见
# config/preinstall/features.config。
# AP 模式成熟度（作 AP 的预期，选卡时注意）：mt76 / ath11k / ath12k 是 OpenWrt 主力
# 方案（AP 好）；iwlwifi（Intel）AP 可跑但有 6GHz/regdomain（LAR）限制；rtw88/rtw89
# 上游以 STA 为主（更适合做上行/STA）；mt7601u、rtl8xxxu 基本只有 STA。
# 能力符号（段末 DRIVER_11*）见其说明。

# MediaTek（mt76 家族；AP 成熟度最好）
CONFIG_PACKAGE_kmod-mt7921e=y        # MT7921/MT7922 PCIe（7922 由同驱动 + 独立固件覆盖）
CONFIG_PACKAGE_kmod-mt7921u=y        # MT7921/MT7922 USB（MT7921AU 等）
CONFIG_PACKAGE_kmod-mt7925e=y        # MT7925（WiFi 7）PCIe
CONFIG_PACKAGE_kmod-mt7925u=y        # MT7925 USB
CONFIG_PACKAGE_kmod-mt7663u=y        # MT7663 USB
CONFIG_PACKAGE_kmod-mt7601u=y        # 廉价 USB 棒（MT7601U）
CONFIG_PACKAGE_kmod-mt76x0u=y        # MT7610U 棒（固件随 mt76x0-common）
CONFIG_PACKAGE_kmod-mt76x2u=y        # MT7612U 棒（固件随 mt76x2-common）

# Realtek（rtw89 = WiFi6/7 M.2 主力；rtw88 = 上一代）
CONFIG_PACKAGE_kmod-rtw89-8852be=y   # RTL8852BE（M.2 低价 WiFi6 主力；1.2MB 固件）
CONFIG_PACKAGE_kmod-rtw89-8852ce=y   # RTL8852CE（1.5MB）
CONFIG_PACKAGE_kmod-rtw89-8922ae=y   # RTL8922AE（WiFi 7；1.5MB）
CONFIG_PACKAGE_kmod-rtw88-8822ce=y   # RTL8822CE/BE（上一代 M.2）
CONFIG_PACKAGE_kmod-rtw88-8822bu=y   # USB 棒
CONFIG_PACKAGE_kmod-rtw88-8821cu=y   # USB 棒
CONFIG_PACKAGE_kmod-rtl8xxxu=y       # 老 USB 棒（8188EU/8192CU 等）

# Intel（x86 盒子/笔记本最常见；驱动一个包，固件按机型点名）
CONFIG_PACKAGE_kmod-iwlwifi=y
CONFIG_PACKAGE_iwlwifi-firmware-ax200=y   # AX200（1.3MB 固件）
CONFIG_PACKAGE_iwlwifi-firmware-ax201=y   # AX201（CNVi；1.3MB）
CONFIG_PACKAGE_iwlwifi-firmware-ax210=y   # AX210（1.7MB）
CONFIG_PACKAGE_iwlwifi-firmware-be200=y   # BE200（WiFi 7；2.4MB）

# Qualcomm（用户点名进默认档：QCNFA765 = WCN6855 / NCM865 = WCN7850；固件大）
CONFIG_PACKAGE_kmod-ath11k-pci=y          # WiFi 6E（12.1MB 固件）
CONFIG_PACKAGE_ath11k-firmware-wcn6855=y
CONFIG_PACKAGE_kmod-ath12k=y              # WiFi 7（8.4MB 固件）
CONFIG_PACKAGE_ath12k-firmware-wcn7850=y

# AIC8800（廉价 USB WiFi6 棒主力芯片；PCIe 形态同芯片；固件随包投放）
CONFIG_PACKAGE_kmod-aic8800-usb=y
CONFIG_PACKAGE_kmod-aic8800-pcie=y

# 能力符号（hostapd 特性开关，同时是上述驱动的**可选性前提**）：
# 这些驱动包在基座 Kconfig 里对同一符号既 `depends on @DRIVER_11X_SUPPORT` 又
# `select` 它——**不手工置 y 就是死锁**（表现为驱动不可选、被 Kconfig 静默丢弃；
# Gate A 会拦）。CONFIG_DRIVER_11AC_SUPPORT 原在设备种子里，随本层上移。
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
