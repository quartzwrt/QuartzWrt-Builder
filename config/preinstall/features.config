# QuartzWrt 通用功能层（WP-12 预装分层 · L1-功能；所有设备都装）
#
# 本层的"发行版功能承诺"主要经由 **quartz-defaults meta 包**表达（DEPENDS 聚合
# 双 Feed 的核心组件与第三方预装：主题/配置/仪表盘/daemon/app-api/openclash/
# bandix/资源包）——清单在 Packages 仓库 `meta/quartz-defaults/Makefile`，
# 不在本文件重复；本文件只放 meta 包之外、需要显式声明的项与构建选项。
#
# 判据同驱动层：**依赖闭包不抄**——openclash 带出的 bash/curl/ruby/unzip 与
# nft/iptables/tproxy 栈、bandix 带出的 zoneinfo/conntrack、btrfs-progs 带出的
# kmod-fs-btrfs 栈等，一律由 Kconfig 的 select 图重建，不在此列
# （check-manifest.sh 的 Gate B 断言兜底）。
# 注：ttyd 与 quartz 自有 i18n 包无人 select，故显式列出——它们是发行版承诺的
# 用户态工具/界面语言包，不是任何功能包的副产品。

# ── 发行版功能聚合（唯一入口）────────────────────────────────────────────────
CONFIG_PACKAGE_quartz-defaults=y

# ── 发行版承诺的用户态工具与能力（无人 select，显式声明）──────────────────────
CONFIG_PACKAGE_btrfs-progs=y          # btrfs 用户态（kmod-fs-btrfs 闭包随之而来）
CONFIG_PACKAGE_ca-certificates=y      # 系统级 CA 证书（curl/wget 之外的工具链）
CONFIG_PACKAGE_ttyd=y                 # Web 终端（LuCI 侧入口）
CONFIG_PACKAGE_luci-app-ttyd=y        # 系统 → 终端 菜单 + ttyd 配置页
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y # 终端页简体中文（无人 select，显式声明）
CONFIG_PACKAGE_ip6tables-nft=y        # IPv6 防火墙用户态（nft 后端）
CONFIG_PACKAGE_iptables-nft=y         # IPv4 防火墙用户态（nft 后端；xtables-nft 闭包随之）
CONFIG_PACKAGE_iptables-mod-extra=y   # fw4/加速插件的常用扩展匹配
CONFIG_PACKAGE_libnghttp2=y           # curl HTTP/2 支持
CONFIG_PACKAGE_libseccomp=y           # procd 沙箱（对应内核 seccomp）
CONFIG_PACKAGE_ucode-mod-socket=y     # quartz-daemon/app-api 的 socket 能力（显式物化）

# ── LuCI 界面语言包（quartz 自有，无人 select）────────────────────────────────
CONFIG_PACKAGE_luci-i18n-qdashboard-zh-cn=y
CONFIG_PACKAGE_luci-i18n-quartz-config-zh-cn=y

# ── WiFi 用户态（与 drivers.config 的 WiFi 驱动配套；WP-12 追加 2026-10-15）──────
# 只加驱动不加用户态是空转（没有 supplicant/AP 守护进程）：wpad-openssl = hostapd +
# wpa_supplicant 全功能版（与设备层同款；11ax/11be 能力由 drivers.config 的
# DRIVER_11AX/BE_SUPPORT 打开）；wifi-scripts 提供 /sbin/wifi 与 netifd 无线协议，
# wireless-regdb 提供各国法规域数据库。iwinfo / ucode-mod-nl80211 由它们带出。
# （此前这三项在设备层 devices/*/preinstall.config，随"WiFi 驱动进通用层"一并上移。）
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_wireless-regdb=y

# ── 功能包的构建选项（非包；check-manifest.sh 的 Gate B 自动豁免）──────────────
# curl：启用 HTTP2/HTTPS/代理/DNS-over-... 等能力位（当前 .config 定案集）
# 注（2026-10-16）：原 `CONFIG_LIBCURL_TLS_SRP=y` 已删——基座 packages feed 为分支追踪
# （无 SHA 锁），当日构建时快进到上游 "Merge Official Source"，curl 包移除 TLS-SRP
# 选项（新增 Kerberos，默认关）；该行被 Kconfig 静默丢弃，由 Gate A 在构建中拦下。
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_CRYPTO_AUTH=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_HTTP2=y
CONFIG_LIBCURL_HTTP_AUTH=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_TFTP=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_LIBCURL_UNIX_SOCKETS=y
CONFIG_LIBCURL_ZLIB=y
# ruby（openclash 依赖闭包）固定 JIT 开关——该选项无人 select，不显式声明会变默认值
CONFIG_RUBY_ENABLE_YJIT=y
