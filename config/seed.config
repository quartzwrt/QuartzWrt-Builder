# QuartzWrt 构建种子（x86_64 起步；基座 ImmortalWrt 25.12 / apk 体系）
#
# 保持最小集：make defconfig 会补齐默认项。
# 首次构建成功后，用基座树中 ./scripts/diffconfig.sh 的输出回填此文件。

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_CCACHE=y

# x86 根分区大小（MB）：基座默认 160MB 放不下本固件默认包集——
# 实测 rootfs 内容 321MB（docker 栈即占 ~244MB：dockerd/containerd/compose），
# 160MB 会让 ext4 镜像生成失败（ext4_allocate_best_fit_partial: out of space）。
# 1GB 兼顾可写余量（docker 数据目录在根分区）与镜像体积。
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# 双 Feed 元包（docs/TDD.md §3.2）
CONFIG_PACKAGE_quartz-defaults=y
