# QuartzWrt 构建种子（x86_64 起步；基座 ImmortalWrt 25.12 / apk 体系）
#
# 已按 diffconfig 回填（2026-10-12，WP-1；全量构建 + 镜像级验证通过后）：
# 内容 = 当前 .config 相对基座默认值的差集（./scripts/diffconfig.sh 输出），
# 用于固定已验收的包选择与内核符号；基座/Feed 升级后需重新 diffconfig 审阅。
# 说明：
#   - CONFIG_CCACHE 是基座默认值，此处显式保留（docs/TDD.md §7.2）；
#   - docker 栈（docker/dockerd/containerd/runc/compose/dockerman 及 tini）已按
#     用户拍板**移出预装**（2026-10-12）：docker 与 fw4 的 iptables 兼容层冲突
#     （LuCI「检测到旧版规则」告警的根因，WORKPLAN 坑位 #24），且体积 ~244MB；
#     如需 docker 请装后用 nftables 后端配方（同坑位 #24）；
#   - CONFIG_TARGET_ROOTFS_PARTSIZE=1024：实测定案——移出 docker 后 rootfs 内容
#     ~208MB，仍超基座默认 160MB（原 321MB 含 docker 栈，坑位 #14），维持 1024；
#   - CONFIG_FEED_{quartz,thirdparty,video}=m：**distfeeds 收敛（坑位 #41）**——基座
#     官方机制（feeds.mk 对 =m 的 feed 在 distfeeds 里生成 `# ` 注释行）：video 上游
#     快照本就没有、quartz/thirdparty 尚未发布，三条死 feed 会让 `apk upgrade` 以
#     "stale/unavailable repositories" 整体拒绝。
#   - **#41 翻转状态：阶段 1 已执行（2026-10-15）**；URL 见文末（公网 https://sources.quartzwrt.org/quartz-feed，内网直连 http://10.0.0.110:880/quartz-feed 同内容）。
#     翻转条件与阶段 2 流程（WP-9/D10，见 Builder docs/SIGNING-OTA.md §5）；
#     2026-10-15 起改用公网入口（内网穿透 + Let's Encrypt 证书），LAN/远程设备统一走它：
#       阶段 1（自有 feed 接入）：发布签名 feed 后设
#         CONFIG_QUARTZ_FEED_BASE_URL="https://<托管根>"
#       ——固件经 quartz-defaults 生成的 /etc/apk/repositories.d/quartz-feed.list
#       接入自有源；上面三条 =m **保持注释**（不复活官方死链）。
#       阶段 2（全量自包含）：全量镜像发布后设 CONFIG_VERSION_REPO="https://<托管根>"
#       并把 CONFIG_FEED_{quartz,thirdparty} 翻回 =y——两动作必须成对，单独翻 =y
#       会重新指向官方 404 路径。

CONFIG_CCACHE=y
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_FEED_quartz=m
CONFIG_FEED_thirdparty=m
CONFIG_FEED_video=m
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_CRYPTO_AUTH=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_HTTP2=y
CONFIG_LIBCURL_HTTP_AUTH=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_TFTP=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_LIBCURL_TLS_SRP=y
CONFIG_LIBCURL_UNIX_SOCKETS=y
CONFIG_LIBCURL_ZLIB=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-blake2b=y
CONFIG_PACKAGE_kmod-crypto-xxhash=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-extra=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ipt-physdev=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-raid6=y
CONFIG_PACKAGE_kmod-lib-xor=y
CONFIG_PACKAGE_kmod-lib-xxhash=y
CONFIG_PACKAGE_kmod-lib-zlib-deflate=y
CONFIG_PACKAGE_kmod-lib-zlib-inflate=y
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_PACKAGE_kmod-nf-ipt=y
CONFIG_PACKAGE_kmod-nf-ipt6=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-compat=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_libattr=y
CONFIG_PACKAGE_libbpf=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libiptext=y
CONFIG_PACKAGE_libiptext-nft=y
CONFIG_PACKAGE_libiptext6=y
CONFIG_PACKAGE_liblua=y
CONFIG_PACKAGE_liblucihttp-lua=y
CONFIG_PACKAGE_liblzo=y
CONFIG_PACKAGE_libmount=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libreadline=y
CONFIG_PACKAGE_libruby=y
CONFIG_PACKAGE_libseccomp=y
CONFIG_PACKAGE_libubus-lua=y
CONFIG_PACKAGE_libuv=y
CONFIG_PACKAGE_libwebsockets-full=y
CONFIG_PACKAGE_libxtables=y
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_luci-app-dashboard=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-quartz-config=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-qdashboard-zh-cn=y
CONFIG_PACKAGE_luci-i18n-quartz-config-zh-cn=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-theme-quartz=y
CONFIG_PACKAGE_quartz-defaults=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-bigdecimal=y
CONFIG_PACKAGE_ruby-date=y
CONFIG_PACKAGE_ruby-digest=y
CONFIG_PACKAGE_ruby-enc=y
CONFIG_PACKAGE_ruby-pstore=y
CONFIG_PACKAGE_ruby-psych=y
CONFIG_PACKAGE_ruby-stringio=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_ucode-mod-lua=y
CONFIG_PACKAGE_ucode-mod-socket=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_xtables-nft=y
CONFIG_RUBY_ENABLE_YJIT=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# WP-7：thirdparty 收录包（构建但不预装——供自有 feed 发布与按需安装；
# bandix/luci-app-bandix/quartz-runtime-resources 经 quartz-defaults 预装，不在此列）
CONFIG_PACKAGE_luci-app-qmodem-next=m
CONFIG_PACKAGE_qmodem_INCLUDE_generic-qmi-wwan=y
CONFIG_PACKAGE_luci-app-mosdns=m

# WP-9 / D10 阶段 1 翻转（2026-10-15 执行）：自有 apk feed 接入（自建 NAS 静态托管）。
# quartz-defaults 据此生成 /etc/apk/repositories.d/quartz-feed.list（quartz/thirdparty/
# 目标包三行）与 /etc/quartz-ota.url（OTA 源同根，零配置）；索引签名由预置公钥
# quartz.pem 校验。上面三条 CONFIG_FEED_*=m 保持注释（不复活官方死链，坑位 #41）。
# 发布/复核流程见 Builder docs/SIGNING-OTA.md §3.2/§5；发布后自检：
#   scripts/check-feed-live.sh https://sources.quartzwrt.org/quartz-feed
CONFIG_QUARTZ_FEED_BASE_URL="https://sources.quartzwrt.org/quartz-feed"
